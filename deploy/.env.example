# Copy to deploy/.env and fill in. Generate the hash with:
#   docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: bcrypt hashes contain '$', which Compose would otherwise interpolate.
STAR_USER=finanzas
STAR_PASSWORD_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'
STAR_PORT=443
# Hostnames and/or IPs clients type in the browser (certificate is issued for these)
STAR_HOSTS=localhost, star.empresa.local
